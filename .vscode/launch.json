{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① Streamlit 工作台 (app.py)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501", "--server.headless", "false"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "② FastAPI 微服务 (src/api.py)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.api:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "③ 证据链 Δ=0 测试",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_evidence_anchor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "④ PDF 解析 / 扫描件熔断测试",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_pdf_parser.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑤ API 端点测试",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑥ 检索消融实验 (Hit@k / NDCG / MRR)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/eval_benchmark.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑦ 算法手撕自测 (免密钥)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/practice_exam.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑧ 调试当前 Python 文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
